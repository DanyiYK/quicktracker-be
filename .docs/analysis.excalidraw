      "boundElements": [],
      "updated": 1780074191122,
      "link": null,
      "locked": false,
      "text": "Legend:\nE: (edit)\nX: (delete)\n\nEditing will open a Modal asking to put a new date\nthe date must be coherent with other states in the list\nThe date can't be less than the state before\nThe date can't be more than the state after it\n\nDeleting a state, will delete the states after it",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Legend:\nE: (edit)\nX: (delete)\n\nEditing will open a Modal asking to put a new date\nthe date must be coherent with other states in the list\nThe date can't be less than the state before\nThe date can't be more than the state after it\n\nDeleting a state, will delete the states after it",
      "autoResize": true,
      "lineHeight": 1.25
    },
