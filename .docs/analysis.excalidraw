      "lineHeight": 1.25
    },
    {
      "id": "PPmeKaR-Ap70L1_zuITsF",
      "type": "text",
      "x": 172.3502498730469,
      "y": 1352.00002226709,
      "width": 715.9793090820312,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 1678899073,
      "version": 36,
      "versionNonce": 296708847,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779866712544,
      "link": null,
      "locked": false,
      "text": "Un'azienda di spedizioni necessita di un sistema web per gestire le proprie\nspedizioni. Il sistema deve offrire:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un'azienda di spedizioni necessita di un sistema web per gestire le proprie spedizioni. Il sistema deve offrire:",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "2Yh21_P9OYryVGxWtfcf8",
      "type": "text",
      "x": 170.9302978515625,
      "y": 1411.3999862670898,
      "width": 786.939453125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 399244559,
      "version": 22,
      "versionNonce": 1998462945,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779866711108,
      "link": null,
      "locked": false,
      "text": "● una pagina pubblica dove l'utente finale può tracciare il proprio pacco inserendo\nun codice di spedizione",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "● una pagina pubblica dove l'utente finale può tracciare il proprio pacco inserendo un codice di spedizione",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ljP_ZhEtW3LJR8PExMAGa",
      "type": "text",
      "x": 172.3502497890625,
      "y": 1471.5999982670899,
      "width": 663.01953125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 415850337,
      "version": 37,
      "versionNonce": 12334401,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779866674948,
      "link": null,
      "locked": false,
      "text": "● un pannello di backoffice (area admin) per gestire corrieri, pacchi e\naggiornamenti di stato",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "● un pannello di backoffice (area admin) per gestire corrieri, pacchi e aggiornamenti di stato",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "-gPLoRaDgdapb_ysyiTyw",
      "type": "text",
      "x": 172.35024989257812,
      "y": 1531.3999862670898,
      "width": 639.8195190429688,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 981959471,
      "version": 45,
      "versionNonce": 686155041,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779866674948,
      "link": null,
      "locked": false,
      "text": "Ogni spedizione deve avere un codice di tracking univoco generato\nautomaticamente dal sistema al momento della creazione.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ogni spedizione deve avere un codice di tracking univoco generato automaticamente dal sistema al momento della creazione.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "mKZQSEO_l5NsSX-qb0mcG",
      "type": "text",
      "x": 172.35025024414062,
      "y": 1591.1999740600586,
      "width": 779.2994995117188,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 906545985,
      "version": 43,
      "versionNonce": 604936449,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779866674948,
      "link": null,
      "locked": false,
      "text": "Lo storico degli stati di una spedizione deve essere tracciato nel tempo: il\nsistema non deve memorizzare solo lo stato corrente, ma l'intera sequenza di\npassaggi con data, ora e località, in modo da ricostruire il percorso completo del\npacco.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lo storico degli stati di una spedizione deve essere tracciato nel tempo: il sistema non deve memorizzare solo lo stato corrente, ma l'intera sequenza di passaggi con data, ora e località, in modo da ricostruire il percorso completo del pacco.",
      "autoResize": false,
      "lineHeight": 1.25
    },
